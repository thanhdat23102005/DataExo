# DataExodus — Git Ignore

# --- Pi application -----------------------------------------------------
# Everything under pi/data is downloaded or generated: the blocklists and
# GeoIP database come from fetch_reference_data.py, the DuckDB file is
# built from observed traffic and is personal browsing history.
/pi/data/
/pi/.venv/

# --- Research study -----------------------------------------------------
# Your own identifiers. Never commit this.
/research/data/identities.local.yaml

# Databases and their write-ahead logs
/research/data/*.duckdb
/research/data/*.duckdb.*
/research/data/*.db
/research/data/*.db-journal
/research/data/live/
/research/data/*.joblib

# Crawl output and downloadable reference data (large)
/research/data/raw/
/research/data/raw_old_format/
/research/data/blocklists/

# Generated analysis outputs — recreated by analysis/report.py and
# analysis/export_sheet.py from whatever is currently in the database.
/research/figures/
/research/data/per_site.csv
/research/data/per_site_report.xlsx
/research/data/report.md

# Monitoring stack secrets — Grafana admin password + InfluxDB admin token.
# The setup script regenerates them.
/research/monitoring/*/credentials.env

# Monitoring runtime data & downloaded binaries (~650MB, re-downloaded by
# setup_monitoring.sh). Only the dataexodus-* provisioning files are ours.
/research/monitoring/influxdb/influxd
/research/monitoring/influxdb/data/
/research/monitoring/influxdb/LICENSE
/research/monitoring/influxdb/README.md
/research/monitoring/grafana/bin/
/research/monitoring/grafana/data/
/research/monitoring/grafana/data-storage/
/research/monitoring/grafana/docs/
/research/monitoring/grafana/packaging/
/research/monitoring/grafana/plugins-bundled/
/research/monitoring/grafana/public/
/research/monitoring/grafana/tools/
/research/monitoring/grafana/conf/defaults.ini
/research/monitoring/grafana/conf/sample.ini
/research/monitoring/grafana/conf/ldap.toml
/research/monitoring/grafana/conf/ldap_multiple.toml
/research/monitoring/grafana/conf/provisioning/sample/
/research/monitoring/grafana/conf/provisioning/*/sample.yaml
/research/monitoring/grafana/Dockerfile
/research/monitoring/grafana/LICENSE
/research/monitoring/grafana/NOTICE.md
/research/monitoring/grafana/README.md
/research/monitoring/grafana/VERSION

